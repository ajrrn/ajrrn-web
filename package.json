{
  "name": "ajrrn-web",
  "version": "0.1.0",
  "private": true,
  "description": "Website of the Algorithmic Justice for Refugees Research Network (AJRRN) — static site built with Eleventy, deployed on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "build:production": "SITE_MODE=subdomain eleventy",
    "dev": "eleventy --serve",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build:production && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:screenshots": "node scripts/screenshots.js",
    "check": "npm run build && npm test && node scripts/check-links.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "gray-matter": "^4.0.3",
    "playwright": "^1.62.1",
    "wrangler": "^4.124.0"
  }
}
