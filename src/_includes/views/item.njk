{%- set s = strings[lang] -%}
{#- Events are listed on the News & events page (/news/); there is no /events/ list page. -#}
{%- set listSection = "news" if section == "events" else section -%}
{%- set listUrl = ("/" + lang + "/" + listSection + "/") | href(lang) -%}
{%- set listPage = collections.translations["/" + listSection + "/"][lang] -%}
<div class="container page-layout">
  {% include "partials/sectionnav.njk" %}
  <article class="prose item-page">
    <p class="breadcrumb"><a href="{{ listUrl }}">{{ listPage.title if listPage else section }}</a></p>
    <h1>{{ title or name }}</h1>
    <dl class="meta">
      {%- if section == "news" %}
      <dt>{{ s.ui.published }}</dt><dd><time datetime="{{ date | isoDate }}">{{ date | localeDate(lang) }}</time></dd>
      {%- if link %}<dt>{{ s.ui.learn_more }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "events" %}
      <dt>{{ s.ui.when }}</dt><dd><time datetime="{{ date | isoDate }}">{{ date | localeDate(lang) }}</time>{% if end %} – <time datetime="{{ end | isoDate }}">{{ end | localeDate(lang) }}</time>{% endif %}{% if time %}, {{ time }}{% endif %}</dd>
      {%- if location %}<dt>{{ s.ui.where }}</dt><dd>{{ location }}</dd>{% endif %}
      {%- if link %}<dt>{{ s.ui.event_link }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "publications" %}
      {%- if authors %}<dt>{{ s.ui.authors }}</dt><dd>{{ authors }}</dd>{% endif %}
      {%- if venue %}<dt>{{ s.ui.published }}</dt><dd>{{ venue }}, <time datetime="{{ date | isoDate }}">{{ date | localeDate(lang, date_precision or "month") }}</time></dd>{% endif %}
      {%- if link %}<dt>{{ s.ui.publication_link }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "opportunities" %}
      {%- if category %}<dt>{{ s.ui.category }}</dt><dd>{{ s.ui["opportunity_" + category] or category }}</dd>{% endif %}
      {%- if location %}<dt>{{ s.ui.location }}</dt><dd>{{ location }}</dd>{% endif %}
      {%- if deadline %}<dt>{{ s.ui.deadline }}</dt><dd><time datetime="{{ deadline | isoDate }}">{{ deadline | localeDate(lang) }}</time></dd>{% endif %}
      {%- if link %}<dt>{{ link_label or s.ui.learn_more }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "projects" %}
      {%- if stream %}<dt>{{ s.ui.research_streams }}</dt><dd>{{ s.ui["stream_" + (stream | lower)] or stream }}</dd>{% endif %}
      {%- if status %}<dt>{{ s.ui.status }}</dt><dd>{{ status }}</dd>{% endif %}
      {%- if link %}<dt>{{ link_label or s.ui.website }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "people" %}
      {%- if role %}<dt>{{ s.ui.role }}</dt><dd>{{ role }}</dd>{% endif %}
      {%- if affiliation %}<dt>{{ s.ui.affiliation }}</dt><dd>{{ affiliation }}</dd>{% endif %}
      {%- if link %}<dt>{{ s.ui.website }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- elif section == "partners" %}
      {%- if type %}<dt>{{ s.ui.category }}</dt><dd>{{ type }}</dd>{% endif %}
      {%- if location %}<dt>{{ s.ui.location }}</dt><dd>{{ location }}</dd>{% endif %}
      {%- if link %}<dt>{{ s.ui.website }}</dt><dd><a href="{{ link }}">{{ link | displayUrl }}</a></dd>{% endif %}
      {%- endif %}
    </dl>
    {{ content | safe }}
    <p class="back-link"><a href="{{ listUrl }}">{{ s.ui.back_to }} {{ listPage.title if listPage else section }}</a></p>
  </article>
</div>
