{#- One row in a list.  Expects `item`, `section`, `lang`, `s`.
    A template that mixes collections (the News & events page) can set
    `rowSection` to override `section` for the rows it includes. -#}
{%- set d = item.data -%}
{%- set section = rowSection or section -%}
<li class="item-row">
  {%- if section == "news" %}
  <time datetime="{{ item.date | isoDate }}" class="item-date">{{ item.date | localeDate(lang) }}</time>
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  {%- if d.summary %}<p class="item-summary">{{ d.summary }}</p>{% endif %}
  {%- elif section == "events" %}
  <time datetime="{{ item.date | isoDate }}" class="item-date">{{ item.date | localeDate(lang) }}{% if d.end %} – {{ d.end | localeDate(lang) }}{% endif %}{% if d.time %} · {{ d.time }}{% endif %}</time>
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  <p class="item-summary">{% if d.location %}{{ d.location }}{% if d.summary %} — {% endif %}{% endif %}{{ d.summary }}</p>
  {%- elif section == "publications" %}
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  <p class="item-summary">{% if d.authors %}{{ d.authors }}. {% endif %}{% if d.venue %}{{ d.venue }}, {% endif %}<time datetime="{{ item.date | isoDate }}">{{ item.date | localeDate(lang, d.date_precision or "month") }}</time>{% if d.link %} · <a href="{{ d.link }}">{{ s.ui.publication_link }}</a>{% endif %}</p>
  {%- elif section == "opportunities" %}
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  <p class="item-summary">{% if d.location %}{{ d.location }}. {% endif %}{% if d.deadline %}{{ s.ui.deadline }}: <time datetime="{{ d.deadline | isoDate }}">{{ d.deadline | localeDate(lang) }}</time>. {% endif %}{{ d.summary }}</p>
  {%- elif section == "projects" %}
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  <p class="item-summary">{{ d.summary }}{% if d.status %} <span class="tag">{{ d.status }}</span>{% endif %}</p>
  {%- elif section == "people" %}
  {#- People and partners link to their own external pages, not to pages on this site. -#}
  {%- if d.link %}<a class="item-title" href="{{ d.link }}">{{ d.name or d.title }}</a>{% else %}<span class="item-title">{{ d.name or d.title }}</span>{% endif %}
  <p class="item-summary">{% if d.role %}{{ d.role }}{% endif %}{% if d.role and d.affiliation %} · {% endif %}{{ d.affiliation }}{% if d.email %} · <a href="mailto:{{ d.email }}">{{ d.email }}</a>{% endif %}</p>
  {%- elif section == "partners" %}
  {%- if d.link %}<a class="item-title" href="{{ d.link }}">{{ d.name or d.title }}</a>{% else %}<span class="item-title">{{ d.name or d.title }}</span>{% endif %}
  <p class="item-summary">{% if d.type %}{{ d.type }}{% endif %}{% if d.type and d.location %} · {% endif %}{{ d.location }}</p>
  {%- else %}
  <a class="item-title" href="{{ item.url | href(lang) }}">{{ d.title }}</a>
  {%- endif %}
</li>
