{%- set s = strings[lang] -%}
{%- set nav = navigation[lang] -%}
{%- set alternates = collections.translations[translationKey] -%}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <img src="/assets/img/ajrrn-logo-colour.png" alt="" width="260" height="124" class="footer-logo" loading="lazy" decoding="async">
      <p>{{ s.footer.about }}</p>
      {%- if s.footer.land %}<p class="footer-land">{{ s.footer.land }}</p>{% endif %}
    </div>
    <div class="footer-links">
      <ul>
        {%- for item in nav.footer %}
        <li><a href="{{ item.url | href(lang) }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="footer-contact">
      <p><strong>{{ s.contact.organization }}</strong><br>
      {%- for line in s.contact.address_lines %}<bdi>{{ line }}</bdi><br>{% endfor %}
      <a href="mailto:{{ s.contact.email }}">{{ s.contact.email }}</a></p>
      <ul class="lang-list" aria-label="{{ s.ui.language }}">
        {%- for l in site.languages %}
        {%- set alt = alternates[l.code] if alternates else null %}
        {%- set target = alt.url if alt else ("/" + l.code + "/") %}
        <li><a href="{{ target | href(lang) }}" lang="{{ l.code }}" hreflang="{{ l.code }}"{% if l.code == lang %} aria-current="true"{% endif %}>{{ l.name }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ "" | year }} {{ s.footer.copyright }}. {{ s.footer.translation_credit }}</p>
  </div>
</footer>
